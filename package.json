{
  "name": "@designliquido/delegua-dados",
  "version": "0.0.1",
  "description": "Biblioteca para análise de dados, baseada na biblioteca Pandas do Python, adaptada para o ambiente de Delégua.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -V ./LICENSE ./dist && yarn copyfiles -V ./package.json ./dist",
    "publicar-npm": "npm publish ./dist --access public",
    "testes-unitarios": "yarn jest --coverage",
    "testes-unitarios:assistidos": "yarn jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DesignLiquido/delegua-dados"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "delegua",
    "dados",
    "analise",
    "pandas",
    "dataframe",
    "series"
  ],
  "author": "Design Liquido",
  "license": "MIT",
  "devDependencies": {
    "@designliquido/delegua": "^1.15.4",
    "@jest/types": "^29.5.8",
    "@types/jest": "^29.5.11",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^20.10.6",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "mock-fs": "^5.2.0",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@designliquido/delegua-csv": "^0.0.2"
  }
}
